# Sanitized template only. Copy outside Git; all blank values require configuration.
APP_ENV=staging
APP_PORT=8501
MUV_APP_IMAGE=
DB_HOST=postgres
DB_PORT=5432
DB_NAME=muv_staging
DB_USER=muv_staging
DB_PASSWORD=
# Required for BTG parsing; leave blank for the empty UI synthetic smoke.
MUV_BANK_ACCOUNT_ID=
# Existing external directories, readable by app UID 10001; never add real files to Git.
MUV_CONFIG_DIR=
MUV_CREDENTIALS_DIR=
MUV_OPERATIONAL_ROOT=/data/months
MUV_TEMPLATE_ROOT=/data/templates
# Consumed by the host backup command, not loaded implicitly by Python.
BACKUP_RETENTION_DAYS=14
# Optional absolute executable: receives completed dump path, exits nonzero on failure.
BACKUP_UPLOAD_EXECUTABLE=
